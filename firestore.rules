rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.uid == 'po2rFc75KISIx5DuyyiQhznl3nM2';
    }

    function validBuyer(d) {
      return d.keys().hasAll(['name', 'contactNumber', 'address', 'notes', 'archivedAt', 'createdAt'])
        && d.keys().hasOnly(['name', 'contactNumber', 'address', 'notes', 'archivedAt', 'createdAt'])
        && d.name is string && d.name.size() > 0
        && (d.contactNumber == null || d.contactNumber is string)
        && (d.address == null || d.address is string)
        && (d.notes == null || d.notes is string)
        && (d.archivedAt == null || d.archivedAt is timestamp)
        && d.createdAt is timestamp;
    }

    function validSupplier(d) {
      return d.keys().hasAll(['name', 'contactNumber', 'address', 'notes', 'archivedAt', 'createdAt'])
        && d.keys().hasOnly(['name', 'contactNumber', 'address', 'notes', 'archivedAt', 'createdAt'])
        && d.name is string && d.name.size() > 0
        && (d.contactNumber == null || d.contactNumber is string)
        && (d.address == null || d.address is string)
        && (d.notes == null || d.notes is string)
        && (d.archivedAt == null || d.archivedAt is timestamp)
        && d.createdAt is timestamp;
    }

    function validBankAccount(d) {
      return d.keys().hasAll(['profileId', 'buyerId', 'supplierId', 'name', 'accountNumber', 'notes', 'archivedAt', 'createdAt'])
        && d.keys().hasOnly(['profileId', 'buyerId', 'supplierId', 'name', 'accountNumber', 'notes', 'archivedAt', 'createdAt'])
        && d.name is string && d.name.size() > 0
        && d.accountNumber is string && d.accountNumber.size() > 0
        && (d.notes == null || d.notes is string)
        && (d.archivedAt == null || d.archivedAt is timestamp)
        && d.createdAt is timestamp
        && (
          (d.profileId is string && d.profileId.size() > 0 && d.buyerId == null && d.supplierId == null) ||
          (d.profileId == null && d.buyerId is string && d.buyerId.size() > 0 && d.supplierId == null) ||
          (d.profileId == null && d.buyerId == null && d.supplierId is string && d.supplierId.size() > 0)
        );
    }

    function validProduct(d) {
      return d.keys().hasAll(['name', 'sku', 'defaultSupplierRate', 'defaultBuyerRate', 'defaultRetailPrice', 'notes', 'archivedAt', 'createdAt'])
        && d.keys().hasOnly(['name', 'sku', 'defaultSupplierRate', 'defaultBuyerRate', 'defaultRetailPrice', 'notes', 'archivedAt', 'createdAt'])
        && d.name is string && d.name.size() > 0
        && (d.sku == null || d.sku is string)
        && d.defaultSupplierRate is int && d.defaultSupplierRate >= 0
        && d.defaultBuyerRate is int && d.defaultBuyerRate >= 0
        && d.defaultRetailPrice is int && d.defaultRetailPrice >= 0
        && (d.notes == null || d.notes is string)
        && (d.archivedAt == null || d.archivedAt is timestamp)
        && d.createdAt is timestamp;
    }

    match /buyers/{id} {
      allow read: if owner();
      allow create, update: if owner() && validBuyer(request.resource.data);
      allow delete: if false;
    }

    match /suppliers/{id} {
      allow read: if owner();
      allow create, update: if owner() && validSupplier(request.resource.data);
      allow delete: if false;
    }

    match /bankAccounts/{id} {
      allow read: if owner();
      allow create, update: if owner() && validBankAccount(request.resource.data);
      allow delete: if false;
    }

    match /products/{id} {
      allow read: if owner();
      allow create, update: if owner() && validProduct(request.resource.data);
      allow delete: if false;
    }

    match /bills/{id} {
      allow read, write: if owner();
    }

    match /deviceRegistry/{id} {
      allow read, write: if owner();
    }

    match /devices/{id} {
      allow read, write: if owner();
    }

    match /profile/{id} {
      allow read, write: if owner();
    }
  }
}
